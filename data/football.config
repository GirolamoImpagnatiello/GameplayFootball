# SIMULAZIONE DELLE PARTITE
# -1 usa l'orologio; un numero fisso ripete la sequenza casuale.
"random_seed" "-1"
# Durata effettiva di ogni partita, in minuti (da 1 a 180).
"match_duration_minutes" "10"
# false termina sempre dopo il secondo tempo, anche in caso di pareggio.
"match_extra_time_enabled" "false"
# Intervallo della fisica in ms; 0 per la grafica = nessun limite.
"physics_frametime_ms" "10"
"graphics3d_frametime_ms" "0"

# ASPETTO DELLA PARTITA
# random, day, night. Vale per tutte le partite del batch.
"match_lighting" "day"
# random, wide (strisce larghe), narrow (strisce strette).
# Cambia il motivo di taglio dell'erba, non la superficie di gioco.
"match_pitch_pattern" "random"

# REGIA DELLE TELECAMERE
# legacy mantiene la camera storica; single, scheduled e procedural usano i
# preset broadcast. I timestamp della schedule sono secondi dall'avvio regia.
"camera_mode" "procedural"
"camera_single_preset" "MAIN_BROADCAST"
"single_camera" "false"
"camera_changes" "true"
"camera_schedule" "0:MAIN_BROADCAST,4:HIGH_GOAL_SIDE,7:MAIN_BROADCAST"
# Seed dedicato; -1 riusa random_seed (se anch'esso e -1 usa l'orologio).
"camera_seed" "2026"
# In procedural il limite si applica a ogni finestra camera_clip_duration_s.
"camera_clip_duration_s" "5.0"
"camera_max_cuts_per_clip" "1"
"camera_close_up_enabled" "false"
# Pesi modificabili; il director applica inoltre pesi contestuali per area,
# corner, piazzati e gioco fermo.
"camera_MAIN_BROADCAST_weight" "10.0"
"camera_HIGH_WIDE_weight" "4.0"
"camera_HIGH_GOAL_SIDE_weight" "4.0"
"camera_LOW_TOUCHLINE_weight" "1.5"
"camera_LOW_GOAL_SIDE_weight" "1.0"
"camera_CORNER_weight" "0.5"
"camera_BEHIND_GOAL_weight" "0.7"
"camera_CLOSE_UP_weight" "0.15"
# Prima di un corner, mostra una vista dedicata e poi torna alla camera
# broadcast normale. Durata in ms (0 disattiva il taglio).
"camera_corner_closeup_enabled" "true"
"camera_corner_closeup_duration_ms" "1000"
# wide = vista larga frontale; closeup = primo piano originale.
"camera_corner_view" "wide"
# Solo per prove della regia: sostituisce il calcio d'inizio con un corner.
"debug_start_with_corner" "false"
# Sequenza deterministica breve: azione, parata, deviazione in corner,
# preparazione e battuta con più tagli di camera. Solo per test Cosmos.
"debug_save_to_corner_sequence" "false"

# PARTITE AUTOMATICHE
"automatic_batch_enabled" "true"
"automatic_match_count" "10"
"automatic_quit_when_done" "true"
# true sceglie due squadre diverse a caso; false usa gli ID qui sotto.
"automatic_random_teams" "true"
"automatic_home_team_id" "3"
"automatic_away_team_id" "8"
# Numeri delle divise delle due squadre.
"automatic_home_kit" "2"
"automatic_away_kit" "1"

# 1.0 mantiene un comportamento prudente; valori fino a 2.0 aumentano
# passaggi verticali e assist senza rendere meno selettivi i tiri.
"ai_offensive_aggression" "1.50"
# Il tiro viene tentato solo entro questa distanza e se la qualità stimata
# (angolo, equilibrio, pressione, linea di tiro e tecnica) supera la soglia.
"ai_shot_max_distance" "30.0"
"ai_shot_min_quality" "0.48"
# Nell'ultimo terzo l'IA deve passare, tirare o preparare la conclusione entro
# questo intervallo; l'assistenza riduce l'errore dei soli tiri IA già validati.
"ai_final_third_decision_ms" "800"
"ai_shot_accuracy_assist" "0.82"
"ai_shot_height" "0.075"
# Aumenta i cross realmente tentati e i contrasti difensivi, senza creare
# direttamente corner o falli. La sensibilita' decide quali contatti sono fischiati.
"ai_cross_aggression" "1.35"
"ai_defensive_challenge_aggression" "1.15"
"referee_foul_sensitivity" "1.15"
# Effettua cambi reali a inizio ripresa usando i giocatori in panchina.
"ai_automatic_substitutions" "true"
"ai_halftime_substitutions_per_team" "1"

# ACQUISIZIONE COSMOS TRANSFER
"cosmos_capture_enabled" "true"
# Fotogrammi al secondo; 0 fotogrammi totali = intera partita.
"cosmos_capture_fps" "25"
"cosmos_capture_frame_count" "0"
# Fotogrammi iniziali da saltare.
"cosmos_capture_skip_frames" "0"
"cosmos_capture_root" "output/cosmos_transfer"
# Formato: video o png. Lockstep sincronizza simulazione e acquisizione.
"cosmos_capture_format" "video"
"cosmos_capture_lockstep" "true"
"cosmos_segmentation_team_aware" "true"
# Separa cartelloni, pareti/barriere, pubblico e struttura delle tribune.
"cosmos_segmentation_v2" "true"
# Depth metrica globale: stessa scala per ogni camera e ogni frame.
# linear_metric mantiene vicino=chiaro e lontano=nero; legacy_device ripristina il vecchio export.
"cosmos_depth_mapping" "linear_metric"
"cosmos_depth_near_m" "1.0"
"cosmos_depth_far_m" "220.0"
# Parametri scritti nel JSON di inferenza Cosmos.
"cosmos_shift" "7.0"
"cosmos_num_steps" "10"
"cosmos_guidance" "4.0"
"cosmos_control_guidance" "1.0"
"cosmos_inference_seed" "2026"
"cosmos_test_name" "gameplayfootball_transfer_depth_seg"
# Caption generale; una clip evento puo' sovrascriverla con una descrizione specifica.
"cosmos_capture_prompt" "A photorealistic broadcast soccer match in a modern stadium. Players move on a marked green pitch. Advertising boards and low barriers sit immediately beyond the touchline; spectators fill the stands behind them. Keep the physical spacing and occlusion between players, boards, barriers, and crowd consistent with the camera view."
"cosmos_ffmpeg_path" "C:\Users\Girni\AppData\Local\Microsoft\WinGet\Packages\Gyan.FFmpeg_Microsoft.Winget.Source_8wekyb3d8bbwe\ffmpeg-8.1.2-full_build\bin\ffmpeg.exe"

# ESPORTAZIONE DATASET
"dataset_export_enabled" "true"
"dataset_export_root" "output/datasets/soccerreplay1988_10min_pilot"
# Salva anche i singoli fotogrammi nel dataset.
"dataset_export_frames" "false"

# ESPORTAZIONE BLENDER TRACKING
"blender_tracking_export_enabled" "false"
"blender_tracking_export_fps" "25"
"blender_tracking_export_root" "output/blender_tracking"

# CLIP DEGLI EVENTI
# Richiede cattura video e script di estrazione.
"cosmos_auto_extract_event_clips" "false"
"cosmos_event_clip_output_root" "output/event_clips"
"cosmos_event_clip_script" "../../tools/extract_event_clips.ps1"
